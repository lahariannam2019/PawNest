NODE_ENV=development
PORT=4000
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/pawnest
DIRECT_URL=postgresql://postgres:postgres@localhost:5432/pawnest
WEB_ORIGIN=http://localhost:3000
JWT_ACCESS_SECRET=your_jwt_access_secret_must_be_at_least_64_bytes_long_random_string
